# ─── CorbaTales Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# The app reads these from the runtime environment (NOT from a .env file in
# production). For local dev, .env is loaded automatically by Vite.

# ─── Authentication (Clerk) ─────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Payments (Stripe) ──────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — create products at https://dashboard.stripe.com/products
# Monthly: $12.99/mo recurring
STRIPE_PRICE_MONTHLY=price_xxx
# Annual: $99.99/yr recurring
STRIPE_PRICE_ANNUAL=price_xxx
# Webhook secret for listening to Stripe events
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AI Pipeline (OpenAI) ───────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Voice Cloning & TTS (ElevenLabs) ───────────────────────────────────────
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# ─── Database ────────────────────────────────────────────────────────────────
# Connection string for Postgres / Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Vercel Deployment ──────────────────────────────────────────────────────
# Personal access token — generate at https://vercel.com/account/tokens
VERCEL_TOKEN=